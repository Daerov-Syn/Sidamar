# ==========================================================
# Vercel + TiDB Cloud Environment Variables untuk SiDamar
# ==========================================================
# Salin nilai-nilai ini ke:
# Vercel Dashboard -> Project -> Settings -> Environment Variables

APP_NAME=SiDamar
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:P9AXn2L1rNr4i3fVAD5031Ljgy6ZWiuvMdgp8OH3GC0=
# Ganti dengan URL domain Vercel Anda (misal: https://sidamar.vercel.app)
APP_URL=https://your-domain.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning
TRUSTED_PROXIES=*

# Database TiDB Cloud (Serverless MySQL gratis)
DB_CONNECTION=mysql
# Ambil dari detail koneksi TiDB Cloud (misal: gateway01.ap-southeast-1.prod.aws.tidbcloud.com)
DB_HOST=
DB_PORT=4000
DB_DATABASE=test
DB_USERNAME=
DB_PASSWORD=
# Sertifikat SSL Debian di container Vercel
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Session, Cache, & Blade Temporary Path (stateless untuk Vercel)
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
VIEW_COMPILED_PATH=/tmp/views

# Mail (Gunakan SMTP Gmail agar OTP terkirim ke email admin)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=emailanda@gmail.com
MAIL_PASSWORD=app-password-16-digit-gmail
MAIL_FROM_ADDRESS=emailanda@gmail.com
MAIL_FROM_NAME=SiDamar
