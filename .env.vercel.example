# Salin nilainya ke Vercel > Settings > Environment Variables.
# Gunakan database dan APP_KEY terpisah untuk Production dan Preview.
APP_NAME=SiDamar
APP_ENV=production
APP_DEBUG=false
# Buat sekali dengan: php artisan key:generate --show
APP_KEY=
# Isi URL HTTPS deployment atau domain yang benar.
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning
TRUSTED_PROXIES=*

# MySQL eksternal; jalankan migrasi sekali dari lingkungan rilis tepercaya.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=sidamar
DB_USERNAME=
DB_PASSWORD=
# Jika penyedia mewajibkan CA khusus, atur path sertifikat yang tersedia di container.
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync

# SMTP diperlukan agar OTP admin terkirim.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SiDamar
